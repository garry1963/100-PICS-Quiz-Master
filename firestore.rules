rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secure System Configuration for Master Admin validation
    match /systemConfig/{configId} {
      allow read, write: if true;
    }

    // Quiz Packs, Questions, Categories: Publicly readable and writable for app synchronization
    match /quizPacks/{packId} {
      allow read, write: if true;
    }

    match /questions/{questionId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // User profiles & Approved Users
    match /users/{userId} {
      allow read, write: if true;
    }

    match /approvedUsers/{userId} {
      allow read, write: if true;
    }

    // Player Progress records
    match /playerProgress/{progressId} {
      allow read, write: if true;
    }

    // System Logs
    match /systemLogs/{logId} {
      allow read, write: if true;
    }
  }
}

