rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if authenticated user is the single authorized Master Admin
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'garrydavies1963@gmail.com' ||
        get(/databases/$(database)/documents/systemConfig/admin).data.masterAdminEmail == request.auth.token.email
      );
    }

    // Secure System Configuration for Master Admin validation
    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // Quiz Packs, Questions, Categories: Publicly readable for gameplay
    match /quizPacks/{packId} {
      allow read: if true;
      allow write: if isMasterAdmin() || request.auth != null;
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isMasterAdmin() || request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isMasterAdmin() || request.auth != null;
    }

    // User profiles & Approved Users
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /approvedUsers/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Player Progress records
    match /playerProgress/{progressId} {
      allow read, write: if true;
    }

    // System Logs
    match /systemLogs/{logId} {
      allow read, write: if true;
    }
  }
}

